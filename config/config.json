{
  "agent": {
    "name": "ERSM Host Agent",
    "version": "2.0.0",
    "host_id": "auto",
    "log_level": "INFO"
  },
  "storage": {
    "json_log_path": "logs/events.jsonl",
    "db_path": "storage/ersm.db",
    "fim_baseline_path": "storage/fim_baseline.json"
  },
  "monitors": {
    "system": {
      "enabled": true,
      "interval_seconds": 5,
      "cpu_threshold_percent": 90.0,
      "cpu_duration_seconds": 30,
      "ram_threshold_percent": 90.0,
      "ram_duration_seconds": 30,
      "disk_threshold_percent": 95.0,
      "process_count_threshold": 400
    },
    "auth": {
      "enabled": true,
      "interval_seconds": 5,
      "failure_threshold": 5,
      "time_window_seconds": 60
    },
    "network": {
      "enabled": true,
      "interval_seconds": 5,
      "port_scan_threshold_ports": 20,
      "port_scan_window_seconds": 10,
      "connection_flood_threshold": 500,
      "outbound_threshold": 100,
      "inbound_threshold": 50,
      "spike_threshold": 80,
      "unexpected_ports": [4444, 31337, 6667]
    },
    "network_device": {
      "enabled": true,
      "interval_seconds": 10
    },
    "gateway": {
      "enabled": true,
      "interval_seconds": 10
    },
    "dns": {
      "enabled": true,
      "interval_seconds": 10,
      "trusted_dns_servers": ["8.8.8.8", "1.1.1.1"],
      "failure_threshold": 5,
      "burst_threshold": 50,
      "time_window_seconds": 30
    },
    "firewall": {
      "enabled": true,
      "interval_seconds": 10,
      "block_event_threshold": 5,
      "block_window_seconds": 30
    },
    "usb": {
      "enabled": true,
      "interval_seconds": 5,
      "trusted_vendors": ["Apple Inc.", "Kingston", "SanDisk"],
      "trusted_devices": ["Mouse", "Keyboard", "Headset"],
      "trusted_serials": []
    },
    "process": {
      "enabled": true,
      "interval_seconds": 5,
      "cpu_hog_threshold": 90.0,
      "mem_hog_threshold_mb": 1024,
      "spawn_burst_threshold": 15,
      "spawn_burst_window_seconds": 5,
      "restart_loop_threshold": 5,
      "suspicious_parents": ["word.exe", "excel.exe", "apache2", "nginx", "httpd", "python"]
    },
    "file_integrity": {
      "enabled": true,
      "interval_seconds": 10,
      "monitored_paths": [
        "config"
      ],
      "rapid_modification_threshold": 30,
      "rapid_modification_window_seconds": 10
    },
    "persistence": {
      "enabled": true,
      "interval_seconds": 15
    },
    "arp": {
      "enabled": true,
      "interval_seconds": 10
    },
    "external_security": {
      "enabled": true,
      "interval_seconds": 15
    }
  },
  "risk_engine": {
    "weights": {
      "INFO": 0,
      "LOW": 5,
      "MEDIUM": 15,
      "HIGH": 30,
      "CRITICAL": 50
    },
    "decay_interval_seconds": 10,
    "decay_amount": 2,
    "rate_limit_window_seconds": 60,
    "max_duplicate_points": 2,
    "thresholds": {
      "SAFE": [0, 29],
      "WARNING": [30, 59],
      "HIGH": [60, 79],
      "CRITICAL": [80, 100]
    }
  },
  "correlation_engine": {
    "enabled": true,
    "time_window_seconds": 60,
    "custom_rules": []
  },
  "transport": {
    "console": {
      "enabled": true,
      "banner_refresh_seconds": 2
    },
    "json_logger": {
      "enabled": true
    },
    "serial": {
      "enabled": false,
      "port": "/dev/tty.usbmodem14101",
      "baudrate": 115200
    }
  }
}
